# Copy this file to ".env" and fill in real values.
# NEVER commit the real .env file to Git.

# Port the Express server listens on
PORT=5000

# Address of the React dev server allowed to call this API
CLIENT_URL=http://localhost:3000

# MySQL database settings (used from Stage 3)
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_NAME=skillbridge_ai

# OpenAI API key (used from Stage 8). Keep secret. Leave empty to run the app
# in demo mode without AI features.
OPENAI_API_KEY=
