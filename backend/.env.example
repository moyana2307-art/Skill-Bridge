# Copy this file to ".env" and fill in real values.
# NEVER commit the real .env file to Git.

# Port the Express server listens on
PORT=5000

# development | production
NODE_ENV=development

# Address(es) of the frontend allowed to call this API. Separate multiple
# origins with commas. For the combined Vercel service, use the final domain.
# Preview deployments ending in .vercel.app are also accepted by the app.
CLIENT_URL=http://localhost:3000
# Vercel production example: https://your-project.vercel.app

# MySQL database settings (used from Stage 3)
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_NAME=skillbridge_ai

# Enable TLS for managed MySQL providers. For Aiven, keep TLS enabled and
# use the service port (not 3306) plus the host shown in the Aiven console.
# DB_SSL_REJECT_UNAUTHORIZED=true is suitable for Aiven's trusted CA setup.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Secret used to sign login tokens. Generate a long random value and never
# commit the real one. In PowerShell:
#   [Convert]::ToBase64String((1..64 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=replace-with-a-long-random-secret

# How long a login lasts. Examples: 12h, 7d.
JWT_EXPIRES_IN=7d

# AI provider: "ollama" (free, local, default) or "openai" (paid API).
AI_PROVIDER=ollama

# Local Ollama settings. Install Ollama, start it, and pull the model once:
#   ollama pull llama3.2:3b
# A smaller model needs less memory; a larger model usually gives better answers.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_MS=120000
OLLAMA_NUM_CTX=4096

# Optional OpenAI settings. Leave AI_PROVIDER=ollama unless you want to use
# OpenAI; then set AI_PROVIDER=openai and add a key. Keep the key secret.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=45000

# Real opportunity sync (ReliefWeb + Remotive). The backend refreshes listings
# on startup and then every OPPORTUNITY_SYNC_INTERVAL_HOURS hours.
OPPORTUNITY_SYNC_ENABLED=true
OPPORTUNITY_SYNC_INTERVAL_HOURS=6

# ReliefWeb requires an APPROVED appname. Request one here:
# https://apidoc.reliefweb.int/parameters#appname
# Leave empty to skip ReliefWeb and import Remotive listings only.
RELIEFWEB_APP_NAME=skillbridge