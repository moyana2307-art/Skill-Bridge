# Copy this file to ".env.local" for local overrides, or set the same variable
# in Vercel for production. Create React App reads it at build time.
#
# The URL must include "/api" and must point at the backend, not the frontend.
# Never put backend secrets (JWT_SECRET, OPENAI_API_KEY, database passwords)
# in a frontend environment file: everything here is visible in the browser.
REACT_APP_API_URL=http://localhost:5000/api
